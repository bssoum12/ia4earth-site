# Formulaire d'inscription (route /api/register, via Resend)
RESEND_API_KEY=
REGISTRATION_TO_EMAIL=contact@salondedeveloppementdurable.com
REGISTRATION_FROM_EMAIL="IA4EARTH <inscription@salondedeveloppementdurable.com>"

# Administration (/admin) : mot de passe unique + secret de session aléatoire (16 caractères minimum)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Stockage des participants (production). Sans ces variables, un fichier local .data/participants.json est utilisé (développement uniquement).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Protection anti-robot Cloudflare Turnstile (formulaires du salon et des master class).
# Sans TURNSTILE_SECRET_KEY, la vérification est désactivée (développement). La clé de site est lue à la compilation.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
